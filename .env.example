# ===== Cloudflare R2（必填）=====
# 在 Cloudflare Dashboard -> R2 -> Manage R2 API Tokens 创建 S3 兼容凭据
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=your_bucket_name

# 可选：自定义 endpoint（默认 https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com）
# R2_ENDPOINT=
# 可选：region，R2 固定用 auto
# R2_REGION=auto

# ===== 服务 =====
PORT=3000
HOST=0.0.0.0
# 设置后所有 /api 请求需携带 Authorization: Bearer <key> 或 x-api-key: <key>
# API_KEY=

# ===== ffprobe =====
FFPROBE_PATH=ffprobe
# 单次 ffprobe 超时（毫秒），默认 30000
# PROBE_TIMEOUT_MS=30000
# 允许解析的最大文件体积（字节），默认 2 GiB
# MAX_FILE_BYTES=2147483648
# 临时文件目录前缀
# TEMP_DIR_PREFIX=metaparse-
# 日志级别：debug | info | warn | error，默认 info
# LOG_LEVEL=info
